# Tinker's Lab Platform — Environment Variables
# Copy this file to .env.local and fill in your Firebase project values.
# Do NOT commit .env.local to version control.

# Firebase API key. Either form works:
#  - VITE_FIREBASE_API_KEY=your_api_key_here           (plain)
#  - VITE_FIREBASE_API_KEY_B64=<base64>                (legacy base64-encoded form)
# NOTE: Firebase API keys are public by design (baked into the client bundle);
# they identify the project, they are NOT a secret. Access control lives in
# firestore.rules / storage.rules / Cloud Functions, never in the key.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_API_KEY_B64=

VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to "true" to use local Firebase emulators (for development)
VITE_USE_EMULATORS=false

# Optional: enable Firebase App Check (ReCAPTCHA Enterprise) in the app.
# Must also be provisioned in the Firebase console and functions must be
# redeployed with enforceAppCheck: true. See docs/firebase/DEPLOYMENT.md.
# VITE_FIREBASE_APP_CHECK_KEY=