rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ================================================================
    // HELPER — staff role check (reads the Firestore user document)
    // ================================================================
    function isActiveUser() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive != false;
    }

    function isStaff() {
      return isActiveUser()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             in ['super_admin', 'faculty', 'lab_assistant'];
    }

    // ================================================================
    // HELPER — project owner check (reads the Firestore project doc)
    // ================================================================
    function isProjectOwner(projectId) {
      return isActiveUser()
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.userId
             == request.auth.uid;
    }

    // ================================================================
    // EQUIPMENT IMAGES
    // Read: any authenticated user (images shown in the equipment catalog).
    // Write/delete: staff only, restricted to jpeg/png/webp under 5 MB.
    // ================================================================
    match /equipment/{equipmentId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if isStaff()
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isStaff();
    }

    // ================================================================
    // PROJECT IMAGES (project gallery / proof-of-work)
    // Read/write/delete: project owner or staff — matches the Firestore
    // project-doc read rule (owner/staff only). Private proof-of-work must
    // not be readable by arbitrary authenticated users.
    // ================================================================
    match /projects/{projectId}/images/{fileName} {
      allow read:   if isProjectOwner(projectId) || isStaff();
      allow write:  if (isProjectOwner(projectId) || isStaff())
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isProjectOwner(projectId) || isStaff();
    }

    // ================================================================
    // PROJECT DOCUMENTS (reports, CAD files, etc.)
    // Read/write/delete: project owner or staff — same parity as images.
    // ================================================================
    match /projects/{projectId}/documents/{fileName} {
      allow read:   if isProjectOwner(projectId) || isStaff();
      allow write:  if (isProjectOwner(projectId) || isStaff())
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)|text/(plain|markdown)|image/(jpeg|png|webp)');
      allow delete: if isProjectOwner(projectId) || isStaff();
    }

    // ================================================================
    // WORKSHOP MATERIALS (slides, handouts, certificates)
    // Read: any authenticated user. Write/delete: staff only.
    // ================================================================
    match /workshops/{workshopId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if isStaff()
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)|text/(plain|markdown)|image/(jpeg|png|webp)');
      allow delete: if isStaff();
    }

    // ================================================================
    // DEFAULT DENY — everything else
    // ================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
