rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // HELPER FUNCTIONS — evaluated server-side, no extra reads needed
    // ================================================================

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // NOTE: each helper call below costs 1 read — minimise usage
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    // A user is "active" unless their profile explicitly sets isActive == false.
    // (Missing/legacy profile docs without the field are treated as active.)
    // This is what actually revokes access when an admin deactivates an account.
    function isActiveUser() {
      return isAuth() && getUserData().isActive != false;
    }

    function isAdmin() {
      return isActiveUser() && getUserRole() == 'super_admin';
    }

    function isStaff() {
      return isActiveUser() && getUserRole() in ['super_admin', 'faculty', 'lab_assistant'];
    }

    // Uploaded-file URL allow-list — mirrors createProject. Client edits to
    // imageUrls/documentUrls are constrained server-side, not just at create.
    function isSafeStorageUrl(value) {
      return value is string
        && value.size() <= 500
        && value.matches('^https://firebasestorage\\.googleapis\\.com/.*$');
    }

    function hasOnlySafeStorageUrls(list) {
      // Positional bound-checking instead of list.all(lambda) — identical
      // semantics (max 12 entries, every entry a safe storage URL) but the
      // Firestore Emulator does not support lambda expressions in rules.
      return list is list
        && list.size() <= 12
        && (list.size() == 0 || isSafeStorageUrl(list[0]))
        && (list.size() <= 1 || isSafeStorageUrl(list[1]))
        && (list.size() <= 2 || isSafeStorageUrl(list[2]))
        && (list.size() <= 3 || isSafeStorageUrl(list[3]))
        && (list.size() <= 4 || isSafeStorageUrl(list[4]))
        && (list.size() <= 5 || isSafeStorageUrl(list[5]))
        && (list.size() <= 6 || isSafeStorageUrl(list[6]))
        && (list.size() <= 7 || isSafeStorageUrl(list[7]))
        && (list.size() <= 8 || isSafeStorageUrl(list[8]))
        && (list.size() <= 9 || isSafeStorageUrl(list[9]))
        && (list.size() <= 10 || isSafeStorageUrl(list[10]))
        && (list.size() <= 11 || isSafeStorageUrl(list[11]));
    }

    // ================================================================
    // USERS COLLECTION
    // ================================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // New users self-create with role='student' only
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'userType', 'isActive', 'createdAt'])
                    && request.resource.data.role == 'student';
      // Users update their own non-sensitive fields; admins update anything
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive', 'email']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ================================================================
    // EQUIPMENT COLLECTION
    // ================================================================
    match /equipment/{equipmentId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    // ================================================================
    // COUNTERS COLLECTION  (atomic project code counter)
    // counters/projects → { nextId: N }
    // ⚠️ WRITES ARE SERVER-ENFORCED: the `createProject` Cloud Function
    // increments the counter inside a transaction with the Admin SDK.
    // Direct client writes are denied so users cannot tamper with the
    // counter and cause duplicate TL-XXX codes.
    // ================================================================
    match /counters/{counterId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // ================================================================
    // BOOKINGS — PROJECT SUBCOLLECTION  (Form 2A — Tier 1 machines)
    // projects/{projectId}/bookings/{bookingId}
    // ================================================================
    match /projects/{projectId}/bookings/{bookingId} {
      // Readable by the project owner or staff (collection-group reads included)
      allow read: if isAuth() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
        || isStaff()
      );
      // ⚠️ CREATION IS SERVER-ENFORCED: the `createBooking` Cloud Function
      // (functions/src/createBooking.ts) performs the conflict check inside a
      // transaction and writes with the Admin SDK, which bypasses rules. Direct
      // client creation is denied so a malicious client cannot skip conflict
      // detection or forge fields. Cancellation/status updates stay client-side.
      allow create: if false;
      // Users can cancel own bookings (status/cancelledBy only); staff can fully update.
      allow update: if isAuth() && (
        (isActiveUser()
         && resource.data.userId == request.auth.uid
         && request.resource.data.status == 'cancelled'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'updatedAt']))
        || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ================================================================
    // TOOL CHECKOUTS — PROJECT SUBCOLLECTION  (Form 2B — Tier 2 tools)
    // projects/{projectId}/checkouts/{checkoutId}
    // ================================================================
    match /projects/{projectId}/checkouts/{checkoutId} {
      allow read: if isAuth() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
        || isStaff()
      );
      // Creation is server-enforced by createToolCheckout so identity, project status,
      // date validity, and the activity entry are written atomically.
      allow create: if false;
      // Owners may only mark an ACTIVE (unreturned) checkout overdue or perform
      // one return; staff can update any checkout.
      allow update: if isAuth() && (
        (isActiveUser() && resource.data.userId == request.auth.uid && (
          (
            resource.data.action == 'checking_out'
            && (!resource.data.keys().hasAny(['returnedAt']) || resource.data.returnedAt == null)
            && request.resource.data.action == 'returning'
            && request.resource.data.returnedAt is timestamp
            && request.resource.data.conditionAtReturn in ['good', 'fair', 'damaged']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['action', 'conditionAtReturn', 'returnedAt', 'notes', 'updatedAt', 'isOverdue'])
            && request.resource.data.isOverdue == false
          )
          || (
            resource.data.action == 'checking_out'
            && (!resource.data.keys().hasAny(['returnedAt']) || resource.data.returnedAt == null)
            && request.resource.data.isOverdue == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOverdue', 'updatedAt'])
          )
        ))
        || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ================================================================
    // PROJECT ACTIVITY LOG  (projects/{projectId}/activityLog/{logId})
    // Immutable unified timeline — appended by the app on bookings,
    // checkouts, returns, and project status changes.
    // ================================================================
    match /projects/{projectId}/activityLog/{logId} {
      allow read: if isAuth() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
        || isStaff()
      );
      // ⚠️ APPENDS ARE SERVER-ENFORCED: the `appendActivityLog` Cloud Function
      // (functions/src/appendActivityLog.ts) verifies the caller owns the project
      // (or is staff), validates the entry type/summary, and stamps a SERVER
      // timestamp. Direct client creation is denied so a malicious client cannot
      // forge entries, fake actors, or backdate the timeline.
      allow create: if false;
      allow update, delete: if false; // Immutable log
    }


    // ================================================================
    // INVENTORY COLLECTION  (admin stock management)
    // ================================================================
    match /inventory/{itemId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // INVENTORY TRANSACTIONS COLLECTION  (admin stock movements only)
    // ================================================================
    match /inventoryTransactions/{txId} {
      allow read: if isAuth();
      // Only staff create transactions (restock/adjustment/damage) — NOT users doing checkouts
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ================================================================
    // MAINTENANCE COLLECTION
    // ================================================================
    match /maintenance/{recordId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // WORKSHOPS COLLECTION
    // ================================================================
    match /workshops/{workshopId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // WORKSHOP REGISTRATIONS COLLECTION
    // ================================================================
    match /workshopRegistrations/{regId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      // Staff can update any registration. Owners may only cancel their
      // registration or leave post-workshop feedback/rating. Each path is its
      // own allow statement (multiple allow statements OR together) so the
      // Firestore Emulator can evaluate them without nested-lambda issues.
      allow update: if isStaff();
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled';
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'updatedAt'])
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 500;
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'rating', 'updatedAt'])
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 500
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // ================================================================
    // PROJECTS COLLECTION  (Form 1 — Project Registration)
    // ================================================================
    match /projects/{projectId} {
      // Projects are only visible to their owner and staff — NOT all authenticated users.
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      // ⚠️ CREATION IS SERVER-ENFORCED: the `createProject` Cloud Function
      // (functions/src/createProject.ts) validates input, increments the
      // atomic counter, and seeds timeline + roster with the Admin SDK.
      // Direct client creation is denied.
      allow create: if false;
      // Users edit own pending/active projects (not status); admins change anything.
      // imageUrls/documentUrls must stay on our Storage bucket even on edits.
      allow update: if isAuth() && (
        (isActiveUser()
         && resource.data.userId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'title', 'abstract', 'contact', 'startDate', 'endDate', 'resourceLink',
           'expectedEquipmentNeeds', 'equipmentNeedsOther',
           'safetyAgreementAccepted', 'termsAccepted', 'imageUrls', 'documentUrls', 'updatedAt'
         ])
         // Agreements, once accepted at registration, cannot be un-accepted by an edit
         // (they may only be re-confirmed as true — flipping to false is denied).
         && (!request.resource.data.keys().hasAny(['safetyAgreementAccepted']) || request.resource.data.safetyAgreementAccepted == true)
         && (!request.resource.data.keys().hasAny(['termsAccepted']) || request.resource.data.termsAccepted == true)
         && (!request.resource.data.keys().hasAny(['imageUrls']) || hasOnlySafeStorageUrls(request.resource.data.imageUrls))
         && (!request.resource.data.keys().hasAny(['documentUrls']) || hasOnlySafeStorageUrls(request.resource.data.documentUrls)))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ================================================================
    // PROJECT MEMBERS  (projects/{projectId}/projectMembers/{memberId})
    // Structured roster — seeded at project creation, owner/staff editable.
    // ================================================================
    match /projects/{projectId}/projectMembers/{memberId} {
      allow read: if isAuth() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
        || isStaff()
      );
      allow create, update: if isActiveUser() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
        || isStaff()
      );
      allow delete: if isAdmin()
                    || (isActiveUser()
                        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid);
    }

    // ================================================================
    // NOTIFICATIONS COLLECTION
    // ================================================================
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // In-app notifications created by staff/admin only (Phase 9 email deferred)
      allow create: if isStaff();
      // Users mark their own as read (isRead field only)
      allow update: if isAuth() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }

    // ================================================================
    // ANNOUNCEMENTS COLLECTION
    // ================================================================
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    // ================================================================
    // ISSUES COLLECTION  (Form 4 — Report an Issue / Suggestion)
    // ================================================================
    match /issues/{issueId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      // New issues start 'open' with valid enums and no injected resolution/status fields.
      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.type in ['machine_malfunction', 'safety_concern', 'missing_damaged', 'suggestion', 'other']
                    && request.resource.data.severity in ['low', 'medium', 'high', 'urgent']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() >= 20
                    && request.resource.data.keys().hasOnly(['type', 'severity', 'relatedMachine', 'description', 'dateNoticed', 'userId', 'userName', 'userEmail', 'status', 'createdAt', 'updatedAt']);
      // Staff update status/resolution; users cannot edit after submission
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // AUDIT LOGS COLLECTION  (append-only, immutable)
    // ================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Audit entries must be written by staff only — no client-side forging.
      allow create: if isStaff();
      allow update, delete: if false; // Immutable
    }

    // ================================================================
    // SETTINGS COLLECTION
    // ================================================================
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ================================================================
    // FEEDBACK COLLECTION (with server-side rate limiting)
    // ================================================================
    match /feedback/{feedbackId} {
      // Only staff/admin can read feedback
      allow read: if isStaff();
      // ⚠️ CREATION IS SERVER-ENFORCED: the `submitFeedback` Cloud Function
      // (functions/src/submitFeedback.ts) enforces a 5-minute cooldown via
      // feedbackWindows/{uid} with the server clock and writes with the Admin
      // SDK. Direct client creation is denied — the old client-predictable
      // document-ID scheme is retired.
      allow create: if false;
      // No one can edit or delete feedback
      allow update, delete: if false;
    }

    // ================================================================
    // BOOKING SLOT OCCUPANCY  (privacy-safe machine availability)
    // slots/{equipmentId}_{date}_{startTime}
    // Written by the createBooking Cloud Function (and synced by
    // syncBookingSlot on status changes). Contains ONLY machine/date/time
    // occupancy — no user identity, purpose, or project info — so any
    // authenticated user can render the booking calendar and slot picker
    // without exposing other users' private booking details.
    // ================================================================
    match /slots/{slotId} {
      allow read: if isAuth();
      allow write: if false; // Server-written only (Admin SDK bypasses rules)
    }

    // ================================================================
    // DEFAULT DENY
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
